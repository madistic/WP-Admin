DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
AUTO_DELIVER_AFTER_MINUTES=

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_CATALOG_ID=

# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
# Exposed to the browser via next.config.ts env block (no NEXT_PUBLIC_ prefix needed).
# Add ALL THREE of these to your Vercel project → Settings → Environment Variables.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@restroconnect.app

# Google Review Link (optional – also configurable from the Settings page in the dashboard)
GOOGLE_REVIEW_URL=
