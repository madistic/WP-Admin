generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id                        String   @id @default(uuid())
  name                      String
  slug                      String   @unique
  logo_url                  String?
  phone                     String?
  whatsapp_number           String?
  email                     String?
  description               String?
  address                   String?
  city                      String?
  state                     String?
  pincode                   String?
  delivery_radius           Float    @default(0)
  minimum_order             Float    @default(0)
  delivery_fee              Float    @default(0)
  printer_settings          String?
  whatsapp_phone_number_id  String?  @unique
  whatsapp_catalog_id       String?
  is_open                   Boolean  @default(true)

  // Loyalty System
  loyalty_enabled                  Boolean  @default(false)
  loyalty_points_value_inr         Float    @default(1.0)
  loyalty_amount_for_one_point     Float    @default(100.0)
  loyalty_min_order_value          Float    @default(500.0)
  loyalty_max_redemption_percent   Float    @default(50.0)

  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  users            User[]
  branches         Branch[]
  categories       MenuCategory[]
  items            MenuItem[]
  orders           Order[]
  customers        Customer[]
  customerNotes    CustomerNote[]
  customerActivities CustomerActivity[]
  customerAddresses CustomerAddress[]
  pointsLedgers    PointsLedger[]
}

model Branch {
  id                           String   @id @default(uuid())
  restaurant_id                String
  name                         String
  code                         String
  address                      String?
  phone                        String?
  email                        String?
  latitude                     Float?
  longitude                    Float?
  delivery_enabled             Boolean  @default(true)
  delivery_free_distance_km    Float    @default(1.5)
  delivery_extra_charge_per_km Float    @default(10)
  delivery_charge_rounding     String   @default("PER_STARTED_KM")
  delivery_max_distance_km     Float?
  is_active                    Boolean  @default(true)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  restaurant      Restaurant            @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  users           User[]
  customers       Customer[]
  customerNotes   CustomerNote[]
  customerActivities CustomerActivity[]
  customerAddresses CustomerAddress[]
  orders          Order[]
  carts           WhatsAppCart[]
  messageReceipts WhatsAppMessageReceipt[]

  @@unique([restaurant_id, code])
  @@index([restaurant_id, is_active])
}

model User {
  id            String   @id @default(uuid())
  restaurant_id String
  branch_id     String?
  name          String
  email         String   @unique
  phone         String?
  password_hash String
  role          UserRole @default(SUPER_ADMIN)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  restaurant Restaurant     @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  branch      Branch?         @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  staffNotes  CustomerNote[]

  @@index([restaurant_id, branch_id])
  @@index([restaurant_id, role])
}

enum UserRole {
  SUPER_ADMIN
  BRANCH_ADMIN
  BRANCH_STAFF
}

model Customer {
  id              String   @id @default(uuid())
  restaurant_id   String
  branch_id       String
  name            String
  phone           String
  whatsapp_number String?
  email           String?
  profile_image   String?
  date_of_birth   DateTime?
  gender          String?
  notes           String?
  points_balance  Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  last_order_at   DateTime?

  restaurant Restaurant        @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  addresses  CustomerAddress[]
  orders     Order[]
  staffNotes CustomerNote[]
  activities CustomerActivity[]
  pointsLedgers PointsLedger[]

  @@unique([restaurant_id, branch_id, phone])
  @@index([restaurant_id, branch_id])
  @@index([branch_id, is_active])
}

model CustomerAddress {
  id                           String    @id @default(uuid())
  restaurant_id                String
  branch_id                    String
  customer_id                  String
  address_type                 String    @default("Home") // Home, Work, Other
  label                        String?
  recipient_name               String?
  phone_number                 String?
  address_line                 String
  address_line_2               String?
  landmark                     String?
  area                         String?
  city                         String?
  state                        String?
  pincode                      String?
  normalized_address           String?
  latitude                     Float?
  longitude                    Float?
  calculated_distance_km       Float?
  distance_calculated_at       DateTime?
  geocoding_provider           String?
  geocoding_metadata           String?
  delivery_instructions        String?
  is_default                   Boolean   @default(false)
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id, branch_id, customer_id])
}

model CustomerNote {
  id            String   @id @default(uuid())
  restaurant_id String
  branch_id     String
  customer_id   String
  user_id       String?
  note          String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([restaurant_id, branch_id, customer_id])
}

model CustomerActivity {
  id            String   @id @default(uuid())
  restaurant_id String
  branch_id     String
  customer_id   String
  type          String
  description   String
  metadata      String?
  created_at    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id, branch_id, customer_id])
}

model MenuCategory {
  id            String   @id @default(uuid())
  restaurant_id String
  name          String
  description   String?
  sort_order    Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  items      MenuItem[]
}

model MenuItem {
  id                 String    @id @default(uuid())
  restaurant_id      String
  category_id        String
  name               String
  description        String?
  price              Float
  image_url          String?
  meta_product_sku   String?   // Meta Commerce Catalog SKU / Retailer ID
  meta_sync_status   String?   // SYNCED, FAILED, PENDING
  meta_sync_error    String?
  meta_synced_at     DateTime?
  is_available       Boolean   @default(true)
  is_active          Boolean   @default(true)
  is_veg             Boolean   @default(true)
  prep_time_minutes  Int?      @default(15)
  is_today_special   Boolean   @default(false)
  special_until_date DateTime?
  is_bestseller      Boolean   @default(false)
  deleted_at         DateTime?
  sort_order         Int       @default(0)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  restaurant Restaurant        @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  category   MenuCategory      @relation(fields: [category_id], references: [id], onDelete: Cascade)
  variants   MenuItemVariant[]
  addons     MenuItemAddon[]
  orderItems OrderItem[]
  cartItems  WhatsAppCartItem[]
}

model MenuItemVariant {
  id           String   @id @default(uuid())
  menu_item_id String
  name         String   // Half, Full, Family
  price        Float
  is_available Boolean  @default(true)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
}

model MenuItemAddon {
  id           String   @id @default(uuid())
  menu_item_id String
  name         String   // Extra Cheese, Extra Raita
  price        Float
  is_available Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
}

model Order {
  id                         String        @id @default(uuid())
  order_number               String        @unique
  restaurant_id              String
  branch_id                  String
  customer_id                String
  customer_name_snapshot     String
  customer_phone_snapshot    String
  delivery_address_snapshot  String
  order_type                 OrderType     @default(HOME_DELIVERY)
  delivery_distance_km       Float?
  delivery_charge            Float?
  free_delivery_distance_km  Float?
  delivery_charge_per_km     Float?
  table_number               String?
  client_request_id          String?
  
  points_earned              Int       @default(0)
  points_redeemed            Int       @default(0)
  points_discount_inr        Float     @default(0)

  subtotal                   Float
  delivery_fee               Float
  total                      Float
  payment_method             PaymentMethod @default(COD)
  payment_status            PaymentStatus @default(PENDING)
  status                    OrderStatus   @default(NEW)
  source                    OrderSource   @default(DEV_CRUD)

  created_at          DateTime  @default(now())
  accepted_at         DateTime?
  out_for_delivery_at DateTime?
  delivered_at        DateTime?
  updated_at          DateTime  @updatedAt

  restaurant Restaurant           @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  branch     Branch                @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  customer   Customer             @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  items      OrderItem[]
  history    OrderStatusHistory[]
  pointsLedgers PointsLedger[]

  @@unique([restaurant_id, branch_id, client_request_id])
  @@index([restaurant_id, branch_id, created_at])
  @@index([branch_id, status, created_at])
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  PAID
}

enum OrderType {
  HOME_DELIVERY
  TAKEAWAY
  DINING
}

enum OrderStatus {
  NEW
  IN_PROCESS
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
}

enum OrderSource {
  DEV_CRUD
  POS
  WHATSAPP
  WEBSITE
  PHONE
}

model OrderItem {
  id                  String   @id @default(uuid())
  order_id            String
  menu_item_id        String
  item_name_snapshot  String
  unit_price_snapshot Float
  quantity            Int
  description         String?  // Special instructions (optional)
  line_total          Float
  created_at          DateTime @default(now())

  order    Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Restrict)
}

model OrderStatusHistory {
  id          String      @id @default(uuid())
  order_id    String
  from_status OrderStatus?
  to_status   OrderStatus
  changed_by  String?
  reason      String?
  created_at  DateTime    @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model WhatsAppCart {
  id                       String             @id @default(uuid())
  restaurant_id            String
  branch_id                String
  customer_whatsapp_number String
  checkout_step            String?            // "IDLE", "AWAITING_ADDRESS", "AWAITING_CONFIRMATION", etc.
  customer_name            String?
  delivery_address         String?
  order_type               OrderType?
  applied_points           Int                @default(0)
  applied_points_discount  Float              @default(0)
  processing_message_id    String?
  processing_started_at    DateTime?
  delivery_quote           String?            // JSON snapshot of DeliveryQuoteResult
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  branch     Branch                @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  items      WhatsAppCartItem[]
  selections CategoryItemSelection[]

  @@unique([restaurant_id, branch_id, customer_whatsapp_number])
  @@index([restaurant_id, branch_id, customer_whatsapp_number])
}

model WhatsAppMessageReceipt {
  message_id             String   @id
  interaction_message_id String   @unique
  restaurant_id          String
  branch_id              String
  sender                 String
  status                 String   @default("PROCESSING")
  created_at             DateTime @default(now())
  completed_at           DateTime?

  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id, branch_id, status])
}

model CategoryItemSelection {
  id           String       @id @default(uuid())
  cart_id      String
  menu_item_id String
  quantity     Int          @default(1)
  variant_id   String?
  addons       String?      // JSON array string
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  cart WhatsAppCart @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, menu_item_id])
}

model WhatsAppCartItem {
  id                    String        @id @default(uuid())
  cart_id               String
  menu_item_id          String
  variant_id            String?
  selected_addons       String?       // JSON array string
  quantity              Int           @default(1)
  unit_price_snapshot   Float
  item_name_snapshot    String
  variant_name_snapshot String?
  special_instructions  String?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  cart                  WhatsAppCart  @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  menuItem              MenuItem      @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
}

model PointsLedger {
  id            String   @id @default(uuid())
  customer_id   String
  restaurant_id String
  order_id      String?
  type          PointsTransactionType
  points        Int
  reason        String
  created_at    DateTime @default(now())

  customer   Customer   @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@unique([order_id, type])
  @@index([customer_id])
  @@index([restaurant_id])
}

enum PointsTransactionType {
  EARN
  REDEEM
  REFUND
  REVERSAL
}
